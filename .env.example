VA_HOST=127.0.0.1
VA_PORT=8765
VA_DATA_DIR=data
VA_LOG_LEVEL=INFO

# ---- Phase 2: LLM ----
VA_OLLAMA_URL=http://127.0.0.1:11434
VA_LMSTUDIO_URL=http://127.0.0.1:1234
VA_SINGLE_LOADED_MODEL=true
VA_DISCOVERY_TIMEOUT_S=8
# クラウドAPIキー（任意。UIから登録した場合はDPAPIで暗号化してDB保存）
# VA_OPENAI_API_KEY=
# VA_ANTHROPIC_API_KEY=
# VA_GEMINI_API_KEY=
# ---- 音楽生成 (ACE-Step 1.5) ----
VA_ACESTEP_URL=http://127.0.0.1:8001
# VA_ACESTEP_PATH=D:\wakuwaku_bgm\ACE-Step-1.5
# ---- 音声合成 (Phase 3) ----
VA_VOICEVOX_NEMO_URL=http://127.0.0.1:50121
VA_VOICEVOX_URL=http://127.0.0.1:50021
# ---- 編集・書き出し (Phase 5) ----
# 未指定なら PATH から探す（Blender は Steam の既定パスも探す）
# VA_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# VA_BLENDER_PATH=D:\Steam\steamapps\common\Blender\blender.exe
# 素材として取り込める親フォルダ（JSON配列）
# VA_IMPORT_DIRS=["D:\\videos"]
# VA_TITLE_FONT_PATH=C:\Windows\Fonts\meiryob.ttc
# ---- 素材・音楽生成 (Phase 6) ----
# 素材サービスのAPIキー（UIの「APIキー設定」から登録すれば不要。DPAPIで暗号化保存）
# VA_PEXELS_API_KEY=
# VA_PIXABAY_API_KEY=
# VA_FREESOUND_API_KEY=
VA_ASSET_SEARCH_CACHE_HOURS=24
VA_ASSET_MAX_DOWNLOAD_MB=1024
VA_LLM_ASSET_DOWNLOAD_REQUIRES_APPROVAL=true
# acestep-api を --api-key 付きで起動した場合のみ
# VA_ACESTEP_API_KEY=
VA_MUSIC_UNLOAD_LLM=true

# 文字起こし（uv sync --extra transcribe、GPU は --extra transcribe-gpu も）。モデルは自動で取得しない
# VA_WHISPER_MODEL_DIR=D:\models\faster-whisper-large-v3
# VA_WHISPER_DEVICE=auto

# ローカル LLM のスキル（SKILL.md）。ユーザーのスキルのフォルダ・プロンプトに入れる上限・num_ctx の上限
# VA_SKILLS_ENABLED=true
# VA_SKILLS_DIR=D:\wakuwaku_ai\va_skills
# VA_SKILLS_BUDGET_CHARS=4000
# VA_LLM_MAX_CONTEXT=16384
